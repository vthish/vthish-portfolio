# Private analytics dashboard password
ANALYTICS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Monthly email report via Resend
RESEND_API_KEY=re_xxxxxxxxx
ANALYTICS_EMAIL_TO=devthish17@gmail.com
ANALYTICS_EMAIL_FROM=Portfolio Analytics <analytics@vthish.dev>

# Optional: separate sender identity for public contact-form messages.
# If omitted, the contact form reuses the verified email address from ANALYTICS_EMAIL_FROM.
# CONTACT_EMAIL_FROM=Portfolio Contact <contact@vthish.dev>

# Gemini-powered portfolio chatbot (server-side only; never expose this key in frontend code)
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# Optional model override. Current default in code: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
